# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
MONGO_URI=mongodb://127.0.0.1:27017/workwave

# --- Auth ---
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Client ---
CLIENT_URL=http://localhost:5173

# --- Uploads ---
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=uploads

# --- WebRTC: STUN/TURN ---
# Comma-separated list of STUN servers (no auth needed)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN is required for reliable calls across restrictive NATs/firewalls.
# Get free/dev credentials from a provider (e.g. Twilio, Xirsys, Metered, or self-host coturn).
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
